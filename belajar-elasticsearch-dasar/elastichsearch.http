#### BUlk API
POST {{baseUrl}}/_bulk
Content-Type: application/x-ndjson

{"create" : {"_index" : "customers", "_id" : "Joko"}}
{"name" : "Jokowi Doodo", "register_at" : "2030-05-03 00:00:00"}
{"index" : {"_index" : "customers", "_id" : "budi"}}
{"name" : "Budi Nugraha", "register_at" : "2030-05-06 00:00:00"}
{"update" : {"_index" : "products", "_id" : "1"}}
{"doc" : {"price" : 4000}}
{"create" :  {"_index" : "customers", "_id" : "spammer"}}
{"name" : "Spammer", "register_at" : "2020-02-06 00:00:00"}
{"delete" : {"_index" : "customers", "_id" : "spammer"}}

