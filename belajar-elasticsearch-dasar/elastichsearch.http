GET {{baseUrl}}/products/_mget
Content-Type: application/json

{
  "ids" : [
    "1", "2"
  ]
}

### get order 1 and customer khannedy
GET {{baseUrl}}/_mget
Content-Type: application/json

{
  "docs": [
    {
      "_id" : "1",
      "_index": "orders"
    },
    {
      "_id" : "khannedy",
      "_index": "customers"
    },
    {
      "_id" : "3",
      "_index": "products"
    }
  ]
}


