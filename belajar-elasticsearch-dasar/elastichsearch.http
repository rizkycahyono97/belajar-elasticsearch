@baseUrl = http://localhost:9200

####################################
############ INDEX #################
####################################

### create index customers
PUT {{baseUrl}}/customers

### create index products
PUT {{baseUrl}}/products

### create index orders
PUT {{baseUrl}}/orders

### show all indices
GET {{baseUrl}}/_cat/indices?v

### delete index customers
DELETE {{baseUrl}}/customers

### delete index products
DELETE {{baseUrl}}/products

### delete index orders
DELETE {{baseUrl}}/orders

### show all indices
GET {{baseUrl}}/_cat/indices?v


####################################
######## Dynamic Mapping ###########
####################################

### get customers mapping
GET {{baseUrl}}/customers/_mapping

### update customers mapping
PUT {{baseUrl}}/customers/_mapping
Content-Type: application/json

{
  "date_detection" : true,
  "dynamic_date_formats" : [
    "yyyy-MM-dd HH:mm:ss",
    "yyyy-MM-dd",
    "yyyy/MM/dd HH:mm:ss",
    "yyyy/MM/dd"
  ]
}

### update customers mapping
PUT {{baseUrl}}/customers/_mapping
Content-Type: application/json

{
  "numeric_detection": true
}

### get products mapping
GET {{baseUrl}}/products/_mapping

### update products mapping
PUT {{baseUrl}}/products/_mapping
Content-Type: application/json

{
  "date_detection" : true,
  "dynamic_date_formats" : [
    "yyyy-MM-dd HH:mm:ss",
    "yyyy-MM-dd",
    "yyyy/MM/dd HH:mm:ss",
    "yyyy/MM/dd"
  ]
}

### update products mapping
PUT {{baseUrl}}/products/_mapping
Content-Type: application/json

{
  "numeric_detection" : true
}

### get orders mapping
GET {{baseUrl}}/orders/_mapping

### update orders mapping
PUT {{baseUrl}}/orders/_mapping
Content-Type: application/json

{
  "date_detection" : true,
  "dynamic_date_formats" : [
    "yyyy-MM-dd HH:mm:ss",
    "yyyy-MM-dd",
    "yyyy/MM/dd HH:mm:ss",
    "yyyy/MM/dd"
  ]
}

### update orders mapping
PUT {{baseUrl}}/orders/_mapping
Content-Type: application/json

{
  "numeric_detection" : true
}


